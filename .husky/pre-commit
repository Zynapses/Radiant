#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Ensure PATH includes common package manager locations
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/share/pnpm:$HOME/.pnpm:$PATH"

# Run lint-staged (skip if pnpm not available)
if command -v pnpm >/dev/null 2>&1; then
  pnpm lint-staged
elif command -v npx >/dev/null 2>&1; then
  npx lint-staged
else
  echo "⚠️  Neither pnpm nor npx found - skipping lint-staged"
fi

# Check for secrets (expanded patterns)
echo "🔍 Checking for secrets..."
SECRET_PATTERNS=(
  "AKIA[A-Z0-9]{16}"                          # AWS Access Key ID
  "ASIA[A-Z0-9]{16}"                          # AWS Temporary Access Key
  "['\"]sk-[a-zA-Z0-9]{20,}"                  # OpenAI / generic secret keys
  "-----BEGIN (RSA |EC |DSA )?PRIVATE KEY"     # Private keys
  "password\s*[:=]\s*['\"][^'\"]{8,}['\"]"     # Hardcoded passwords (8+ chars)
  "ghp_[A-Za-z0-9]{36}"                       # GitHub PAT
  "xox[bpors]-[A-Za-z0-9-]+"                  # Slack tokens
  "eyJ[A-Za-z0-9_-]{20,}\\.eyJ[A-Za-z0-9_-]+" # JWT tokens
  "postgres://[^:]+:[^@]+@"                    # Connection strings with creds
  "mongodb(\\+srv)?://[^:]+:[^@]+@"           # MongoDB connection strings
  "RADIANT_DB_PASSWORD=['\"]?[^'\" ]+"         # RADIANT-specific env vars
)
PATTERN=$(IFS='|'; echo "${SECRET_PATTERNS[*]}")
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep -v -E '\.(lock|png|jpg|ico|woff|ttf|eot|svg)$')
if [ -n "$STAGED_FILES" ]; then
  if echo "$STAGED_FILES" | xargs grep -l -E "$PATTERN" 2>/dev/null; then
    echo "❌ Potential secrets detected in staged files!"
    echo "   Review the files above and remove any credentials."
    echo "   Use AWS Secrets Manager or SSM Parameter Store instead."
    echo "   Set SKIP_SECRETS_CHECK=1 to bypass (not recommended)."
    if [ -z "$SKIP_SECRETS_CHECK" ]; then
      exit 1
    fi
  fi
fi

# Version bump enforcement (PROMPT-33 requirement)
if [ -z "$SKIP_VERSION_CHECK" ]; then
  CODE_CHANGED=$(git diff --cached --name-only | grep -E "^(packages/|apps/|migrations/)" | head -1)
  
  if [ -n "$CODE_CHANGED" ]; then
    VERSION_CHANGED=$(git diff --cached --name-only | grep -E "^(VERSION|RADIANT_VERSION|THINKTANK_VERSION)$" | head -1)
    
    if [ -z "$VERSION_CHANGED" ]; then
      echo "⚠️  Code changes detected but no version bump found!"
      echo "   Changed: $CODE_CHANGED"
      echo ""
      echo "   Run: bash tools/scripts/bump-version.sh [patch|minor|major]"
      echo "   Or set SKIP_VERSION_CHECK=1 to bypass"
      exit 1
    fi
  fi
fi

# Run discrete validation
echo "🔍 Running discrete validation..."
if [ -f "tools/scripts/validate-discrete.sh" ]; then
  bash tools/scripts/validate-discrete.sh || {
    echo "❌ Discrete validation failed"
    exit 1
  }
fi

echo "✅ Pre-commit checks passed"
