# OMEGA Proving Ground — Environment Variables
# Copy this file to .env and fill in your keys.
# The server loads .env automatically (requires: pip install python-dotenv)

# ElevenLabs TTS (required for voice output)
# Sign up at https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=
# Optional: change voice (default: Rachel = 21m00Tcm4TlvDq8ikWAM)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Voice Streaming Pipeline (voice_server.py)
# Port for the FastAPI streaming voice server (default: 11436)
# VOICE_PORT=11436
# OMEGA Cortex server URL (default: http://localhost:11435)
# OMEGA_SERVER_URL=http://localhost:11435
# Ollama URL (default: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434
# Ollama model (default: llama3.2:1b)
# OLLAMA_MODEL=llama3.2:1b
