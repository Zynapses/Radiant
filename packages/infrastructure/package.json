{
  "name": "@radiant/infrastructure",
  "version": "6.6.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:lambda": "cd lambda && npm install && npm run build",
    "typecheck": "tsc --noEmit && cd lambda && npx tsc --noEmit",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "diff": "cdk diff",
    "bootstrap": "cdk bootstrap"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.985.0",
    "@aws-sdk/client-glacier": "^3.985.0",
    "@aws-sdk/client-iam": "^3.985.0",
    "@radiant/shared": "workspace:*",
    "aws-cdk-lib": "^2.120.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@aws-sdk/client-athena": "^3.500.0",
    "@aws-sdk/client-cloudwatch": "^3.500.0",
    "@aws-sdk/client-firehose": "^3.500.0",
    "@aws-sdk/client-glue": "^3.500.0",
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/client-sqs": "^3.500.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.0",
    "aws-cdk": "^2.120.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
