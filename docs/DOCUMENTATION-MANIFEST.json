  "completeDocumentation": {
    "description": "Auto-assembled comprehensive documentation — regenerate when ANY doc changes",
    "assemblyScript": "tools/scripts/assemble-complete-documentation.py",
    "policyWorkflow": ".windsurf/workflows/docs-assemble-complete.md",
    "outputs": [
      {
        "path": "docs/publications/RADIANT-THINKTANK-COMPLETE-DOCUMENTATION.md",
        "format": "markdown",
        "description": "Complete assembled documentation in Markdown (auto-generated)"
      },
      {
        "path": "docs/publications/RADIANT-THINKTANK-COMPLETE-DOCUMENTATION.pdf",
        "format": "pdf",
        "description": "Print-ready PDF version (auto-generated via pandoc + xelatex)"
      }
    ],
    "regenerateCommand": "python3 tools/scripts/assemble-complete-documentation.py",
    "parts": 18,
    "note": "Output files are build artifacts — generated from source docs, not edited directly"
  },

