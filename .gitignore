# ═══════════════════════════════════════════════════════════════════════════
# RADIANT .gitignore
# ═══════════════════════════════════════════════════════════════════════════

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
cdk.out/
.build/
*.js.map
*.d.ts
!packages/shared/types/*.d.ts

# Swift Package Manager (only in swift-deployer)
apps/swift-deployer/Packages/
**/.build/

# CDK Output (regenerated on build)
cdk.context.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ═══════════════════════════════════════════════════════════════════════════
# CREDENTIALS - NEVER COMMIT THESE
# ═══════════════════════════════════════════════════════════════════════════
.env*
!.env.example
scripts/setup_credentials.sh
**/credentials*.sh
**/secrets*.sh
**/*secret*
**/*credentials*

# macOS
.DS_Store
xcuserdata/
DerivedData/
.swiftpm/
*.xcodeproj
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Test coverage
coverage/
.nyc_output/

# Temporary
tmp/
temp/
*.tmp

# Large zip archives
*.zip
radiant-source-bundle.zip
radiant-source-code.zip
radiant-source-docs.zip

# ═══════════════════════════════════════════════════════════════════════════
# LARGE / BINARY FILES - NEVER COMMIT
# ═══════════════════════════════════════════════════════════════════════════

# Compiled macOS app bundles
*.app/
*.app

# PDF files (generated — use scripts to rebuild)
*.pdf

# Generated HTML docs
docs/html/
docs/**/*.html
*.html
!apps/**/*.html

# Generated complete documentation (rebuild with assemble-complete-documentation.py)
docs/publications/

# Documentation archives (keep locally, not in git)
docs/archive/

# PDF directories
docs/pdf/
docs/pdf-essential/
docs/pdf-latest/

# Doc exports
docs/exports/

# Exported bundles
radiant-gemini-export.zip
